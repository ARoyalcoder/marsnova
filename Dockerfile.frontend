# syntax=docker/dockerfile:1
# -----------------------------------------------------------------------------
# MarsNova Frontend Production Dockerfile (Multi-stage)
# Stage 1: Build the Vite + React TypeScript SPA
# Stage 2: Serve static production assets via hardened Nginx Alpine
# -----------------------------------------------------------------------------

# Stage 1: Node.js Builder
FROM node:20-alpine AS builder

WORKDIR /app

# Ensure security updates and clean package installation
RUN apk add --no-cache libc6-compat

# Copy dependency manifests first to leverage Docker layer caching
COPY package.json package-lock.json ./

# Install production and build dependencies cleanly
RUN npm ci --prefer-offline --no-audit

# Copy application source code and configurations
COPY index.html vite.config.ts tsconfig.json components.json ./
COPY src/ ./src/
COPY public/ ./public/

# Build optimized production bundle to /app/dist
ARG VITE_API_BASE_URL=""
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
RUN npm run build

# Stage 2: Hardened Nginx Runtime
FROM nginx:1.27-alpine-slim AS runtime

# Install curl for container health check
RUN apk add --no-cache curl tzdata

# Remove default Nginx welcome page
RUN rm -rf /usr/share/nginx/html/*

# Copy compiled production bundle from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy custom Nginx configuration
COPY docker/nginx/conf.d/frontend.conf /etc/nginx/conf.d/default.conf

# Set ownership and secure permissions
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chmod -R 755 /usr/share/nginx/html && \
    touch /var/run/nginx.pid && \
    chown -R nginx:nginx /var/run/nginx.pid /var/cache/nginx

# Non-root user execution
USER nginx

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://127.0.0.1/ || exit 1

STOPSIGNAL SIGQUIT

CMD ["nginx", "-g", "daemon off;"]
