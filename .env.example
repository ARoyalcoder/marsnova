# ==============================================================================
# MarsNova — Environment Configuration Template (.env.example)
# All variables contain safe dummy defaults for local development and testing.
# Replace with real production credentials upon final deployment.
# ==============================================================================

# Frontend Drogon Backend API Endpoint
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_API_BASE=http://localhost:8080/api/v1

# Studio WhatsApp Direct Number (Country code + digits, no spaces or plus)
VITE_WHATSAPP_NUMBER=917208591595

# Optional Cloudflare Turnstile Verification Key (Dummy test site key always passes)
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Optional Compatibility Stores (Dummy placeholders)
VITE_SUPABASE_URL=https://dummy-project.supabase.co
VITE_SUPABASE_ANON_KEY=dummy-anon-key-placeholder-32-chars

# ------------------------------------------------------------------------------
# Backend PostgreSQL Database Credentials (for Drogon & Docker Compose)
# ------------------------------------------------------------------------------
# Connection URLs (Optional standard & JDBC formats)
# DATABASE_URL=postgresql://neondb_owner:password@ep-sample-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require
# DATABASE_JDBC_URL=jdbc:postgresql://ep-sample-pooler.c-7.us-east-2.aws.neon.tech/neondb?user=neondb_owner&password=password&sslmode=require&channelBinding=require

POSTGRES_DB=marsnova_db
POSTGRES_USER=marsnova_app
POSTGRES_PASSWORD=replace_with_strong_random_db_password_32char
DB_HOST=postgres
DB_PORT=5432
DB_NAME=marsnova_db
DB_USER=marsnova_app
DB_PASSWORD=replace_with_strong_random_db_password_32char
DB_SSLMODE=prefer

# ------------------------------------------------------------------------------
# Backend Server Secret Keys & Security
# ------------------------------------------------------------------------------
PORT=8080
APP_THREADS=4
CLIENT_MAX_BODY_SIZE=25M
JWT_SECRET=replace_with_random_64char_jwt_secret
SESSION_SECRET=replace_with_random_64char_hex_session_secret
CORS_ORIGINS=https://marsnova.in,https://www.marsnova.in

# First admin account. There are no built-in staff logins. On startup the backend creates one
# super_admin from these values, but only if no active super_admin exists, and it never
# overwrites an existing account. Password must be 12+ characters. Set a real value, start the
# backend once, then remove MARSNOVA_BOOTSTRAP_ADMIN_PASSWORD from this file.
# MARSNOVA_BOOTSTRAP_ADMIN_EMAIL=
# MARSNOVA_BOOTSTRAP_ADMIN_PASSWORD=
# MARSNOVA_BOOTSTRAP_ADMIN_NAME=Studio Administrator

# WhatsApp Cloud API & Provider Config
WHATSAPP_PROVIDER=click_to_chat
WHATSAPP_NUMBER=917208591595
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Media Storage
STORAGE_PROVIDER=local
STORAGE_BUCKET=marsnova-assets
SUPABASE_STORAGE_URL=
SUPABASE_STORAGE_KEY=

# ------------------------------------------------------------------------------
# Public Gateway & Production Networking
# ------------------------------------------------------------------------------
DOMAIN_NAME=marsnova.in
HTTP_PORT=80
HTTPS_PORT=443
BACKUP_RETENTION_DAYS=14
