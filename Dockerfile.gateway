# syntax=docker/dockerfile:1
# -----------------------------------------------------------------------------
# MarsNova Gateway Production Dockerfile
# Stage 1: Build the React TypeScript SPA
# Stage 2: Package static SPA + Reverse Proxy + Hardened Nginx
# -----------------------------------------------------------------------------

FROM node:20-alpine AS builder

WORKDIR /app

RUN apk add --no-cache libc6-compat

COPY package.json package-lock.json ./
RUN npm ci --prefer-offline --no-audit

COPY index.html vite.config.ts tsconfig.json tsconfig.app.json tsconfig.node.json components.json ./
COPY src/ ./src/
COPY public/ ./public/

ARG VITE_API_BASE_URL=""
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
RUN npm run build

# Stage 2: Hardened Nginx Gateway
FROM nginx:1.27-alpine-slim AS runtime

RUN apk add --no-cache curl tzdata

# Remove default assets
RUN rm -rf /usr/share/nginx/html/* /etc/nginx/conf.d/*

# Copy built frontend assets
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy gateway Nginx configuration
COPY docker/nginx/nginx.conf /etc/nginx/nginx.conf
COPY docker/nginx/conf.d/marsnova.conf /etc/nginx/conf.d/default.conf

EXPOSE 80 443

HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://127.0.0.1/healthz || exit 1

STOPSIGNAL SIGQUIT

CMD ["nginx", "-g", "daemon off;"]
